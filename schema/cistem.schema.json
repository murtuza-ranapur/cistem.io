{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cistem.dev/schema/cistem.schema.json",
  "title": "cistem.dev diagram",
  "description": "A diagram file. `model` describes the system; `layout` only says where things are drawn, so tools that import from text may leave it empty and let the editor auto-organise. Containers are the environments components live in (clouds, accounts, VPCs...); links say how two containers talk and add latency to calls that cross between them.",
  "type": "object",
  "required": [
    "version",
    "kind",
    "meta",
    "model",
    "layout"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 4
    },
    "kind": {
      "enum": [
        "system",
        "sequence",
        "class"
      ],
      "description": "Diagram kind. system: components and edges; sequence: lifelines and rows; class: classes and relations."
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "created",
        "updated"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "description": "system: systemModel; sequence: sequenceModel (chosen by kind)",
      "type": "object"
    },
    "layout": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "systemModel": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/container"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canvasNote"
          }
        }
      }
    },
    "node": {
      "$ref": "#/$defs/nodeBase"
    },
    "nodeBase": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "latency": {
          "type": "number",
          "minimum": 0,
          "description": "Base latency in ms at low utilisation."
        },
        "container": {
          "type": [
            "string",
            "null"
          ],
          "description": "Id of the container this component lives in, or null if unplaced."
        },
        "kind": {
          "type": "string",
          "description": "A component type key from shared/component-types.json (entry, lb, apigw, cdn, service, cache, db, mongodb, queue, sqs, …). The type's behaviour decides which fields matter."
        },
        "variant": {
          "type": "string",
          "description": "What the component calls itself on the card, e.g. a service's type: Microservice, Application, Monolith, Function, Worker, Batch job."
        },
        "logo": {
          "type": "string",
          "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+=*$",
          "maxLength": 60000,
          "description": "A small logo drawn instead of the type's icon, as a data: URL (PNG, JPEG or WebP)."
        },
        "border": {
          "type": "string",
          "enum": [
            "dashed"
          ],
          "description": "Card style: a dashed border (e.g. for something you don't run). Absent = solid."
        },
        "color": {
          "enum": [
            "blue",
            "violet",
            "teal",
            "green",
            "amber",
            "orange",
            "red",
            "pink",
            "slate"
          ],
          "description": "Card colour instead of the type's own."
        },
        "rps": {
          "type": "number",
          "minimum": 0,
          "description": "source: peak requests per second it sends."
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxRps": {
          "type": "number",
          "minimum": 0,
          "description": "balancer / limit: maximum requests per second."
        },
        "instances": {
          "type": "number",
          "minimum": 0,
          "description": "scaled: number of instances."
        },
        "rpsPerInstance": {
          "type": "number",
          "minimum": 0,
          "description": "scaled: requests per second one instance sustains."
        },
        "maxOps": {
          "type": "number",
          "minimum": 0,
          "description": "cache: operations per second."
        },
        "hitRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eviction": {
          "type": "string"
        },
        "maxQps": {
          "type": "number",
          "minimum": 0,
          "description": "store: queries per second per node."
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "readShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxThroughput": {
          "type": "number",
          "minimum": 0,
          "description": "async: messages per second."
        },
        "retentionHours": {
          "type": "number",
          "minimum": 0,
          "description": "async: how long messages are kept, in hours. With a consumer falling behind, the model says when its backlog starts expiring."
        },
        "msgPerPartition": {
          "type": "number",
          "minimum": 0,
          "description": "async, partitioned (Kafka topic): messages per second each partition takes; capacity = partitions × msgPerPartition. A service fed only by partitioned topics uses at most one instance per partition."
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table"
          }
        },
        "partitions": {
          "type": "integer",
          "minimum": 1
        },
        "schema": {
          "type": "string",
          "description": "Avro schema of the message value, JSON text."
        },
        "key": {
          "type": "string",
          "description": "Field used as the message / partition / group key."
        },
        "cluster": {
          "type": "string"
        },
        "fifo": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/noteText"
        },
        "width": {
          "type": "number",
          "minimum": 160,
          "maximum": 720,
          "description": "Card width set by dragging its edge; absent = it follows the type and the name."
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "calls"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "calls": {
          "type": "number",
          "minimum": 0,
          "description": "Downstream calls made per request arriving at `from`."
        },
        "notes": {
          "$ref": "#/$defs/noteText"
        },
        "label": {
          "type": "string",
          "maxLength": 500,
          "description": "Text shown on the line; newlines start new lines."
        },
        "showNotes": {
          "type": "boolean",
          "description": "Show the connection's notes on the line, under the label."
        },
        "line": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ],
          "description": "Line pattern; absent = solid (dashed when it crosses an environment)."
        },
        "color": {
          "enum": [
            "blue",
            "violet",
            "teal",
            "green",
            "amber",
            "orange",
            "red",
            "pink",
            "slate"
          ],
          "description": "Line colour; absent = grey."
        },
        "width": {
          "enum": [
            "thin",
            "thick"
          ],
          "description": "Line width; absent = medium."
        },
        "arrows": {
          "enum": [
            "both",
            "none"
          ],
          "description": "Arrowheads; absent = at the end."
        },
        "endpoints": {
          "type": "array",
          "description": "The target's endpoints this connection calls, by index into its endpoints, each with its own calls per request; `calls` is their sum. (Older files had a single `endpoint` index.)",
          "items": {
            "type": "object",
            "required": [
              "i",
              "calls"
            ],
            "properties": {
              "i": {
                "type": "integer",
                "minimum": 0
              },
              "calls": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "k",
              "v"
            ],
            "properties": {
              "k": {
                "type": "string"
              },
              "v": {
                "type": "string"
              }
            }
          }
        },
        "req": {
          "type": "string",
          "description": "Example request body, JSON text."
        },
        "res": {
          "type": "string",
          "description": "Example response body, JSON text."
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "name",
        "columns"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "pk": {
                "type": "boolean"
              },
              "nullable": {
                "type": "boolean"
              },
              "unique": {
                "type": "boolean"
              },
              "index": {
                "type": "boolean"
              },
              "default": {
                "type": "string"
              },
              "references": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Foreign key target: \"table.column\" in the same database, or \"<node id>:table.column\" in another database node."
              }
            }
          }
        }
      }
    },
    "container": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "cloud",
            "account",
            "vpc",
            "region",
            "datacentre",
            "team"
          ]
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "description": "Enclosing container id; null for a root."
        },
        "provider": {
          "type": "string",
          "description": "e.g. aws, ibm, gcp, on-prem"
        },
        "owner": {
          "type": "string",
          "description": "Team or company responsible."
        },
        "note": {
          "type": "string"
        },
        "color": {
          "enum": [
            "blue",
            "violet",
            "teal",
            "green",
            "amber",
            "orange",
            "red",
            "pink",
            "slate"
          ],
          "description": "Frame colour; omitted = the kind's default."
        },
        "fill": {
          "enum": [
            "tint",
            "solid",
            "outline"
          ],
          "description": "tint = translucent (default), solid = opaque, outline = border only."
        },
        "border": {
          "enum": [
            "dashed",
            "solid"
          ],
          "description": "Frame border style (default dashed)."
        },
        "notes": {
          "$ref": "#/$defs/noteText"
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "type",
        "latencyMs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "description": "same-network | vpc-peering | privatelink | transit-gateway | vpn | direct-connect | public-internet | free text"
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0,
          "description": "Added to every call crossing between these containers (or their descendants)."
        }
      }
    },
    "sequenceModel": {
      "type": "object",
      "required": [
        "participants",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_$][\\w.$-]*$"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "A component type key, or actor"
              },
              "ref": {
                "type": "string",
                "description": "Id of the linked component in the system diagram this sequence uses"
              },
              "notes": {
                "$ref": "#/$defs/noteText"
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "t",
                  "id",
                  "from",
                  "to",
                  "label",
                  "style"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "const": "msg"
                  },
                  "id": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "style": {
                    "enum": [
                      "sync",
                      "async",
                      "reply"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "t",
                  "id",
                  "over",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "const": "note"
                  },
                  "id": {
                    "type": "string"
                  },
                  "over": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "t",
                  "id",
                  "kind",
                  "guard"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "const": "open"
                  },
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "alt",
                      "opt",
                      "loop",
                      "par"
                    ]
                  },
                  "guard": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "t",
                  "id",
                  "guard"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "const": "else"
                  },
                  "id": {
                    "type": "string"
                  },
                  "guard": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "t",
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "const": "close"
                  },
                  "id": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "uses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "tab": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "description": "The system diagram this sequence draws on: its id once saved, else the browser tab it's open in"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canvasNote"
          }
        }
      }
    },
    "classModel": {
      "type": "object",
      "required": [
        "classes",
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "fields",
              "methods"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_$][\\w$]*$"
              },
              "kind": {
                "enum": [
                  "class",
                  "abstract",
                  "interface",
                  "enum",
                  "record"
                ]
              },
              "stereo": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "vis",
                    "name",
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "vis": {
                      "enum": [
                        "+",
                        "-",
                        "#",
                        "~",
                        ""
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "params": {
                      "type": "string",
                      "description": "Present on methods: the parameter list as written"
                    },
                    "static": {
                      "type": "boolean"
                    },
                    "abstract": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "vis",
                    "name",
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "vis": {
                      "enum": [
                        "+",
                        "-",
                        "#",
                        "~",
                        ""
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "params": {
                      "type": "string",
                      "description": "Present on methods: the parameter list as written"
                    },
                    "static": {
                      "type": "boolean"
                    },
                    "abstract": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "notes": {
                "$ref": "#/$defs/noteText"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "inherit",
                  "implement",
                  "composition",
                  "aggregation",
                  "assoc",
                  "depend"
                ]
              },
              "label": {
                "type": "string"
              },
              "fromMult": {
                "type": "string"
              },
              "toMult": {
                "type": "string"
              },
              "notes": {
                "$ref": "#/$defs/noteText"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canvasNote"
          }
        }
      }
    },
    "noteText": {
      "type": "string",
      "maxLength": 50000,
      "description": "Rich notes in markdown (GitHub flavour plus ==highlight==, ++underline++, and <mark data-color>/<span style=\"color\"> for colours)."
    },
    "canvasNote": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "color": {
          "enum": [
            "yellow",
            "blue",
            "green",
            "pink",
            "grey",
            "none"
          ]
        },
        "text": {
          "$ref": "#/$defs/noteText"
        }
      },
      "description": "A note placed on the canvas; where it sits is in layout.notes."
    },
    "noteLayout": {
      "type": "object",
      "description": "Canvas note id → its box in canvas units (h omitted: the height follows the text).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "x",
          "y",
          "w"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "sequence"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "$ref": "#/$defs/sequenceModel"
          },
          "layout": {
            "type": "object",
            "properties": {
              "notes": {
                "$ref": "#/$defs/noteLayout"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "class"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "$ref": "#/$defs/classModel"
          },
          "layout": {
            "type": "object",
            "properties": {
              "positions": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              },
              "notes": {
                "$ref": "#/$defs/noteLayout"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "system"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "$ref": "#/$defs/systemModel"
          },
          "layout": {
            "type": "object",
            "properties": {
              "positions": {
                "type": "object",
