{
  "$comment": "Component types for system diagrams. Read by the browser (src/types.ts) and the server (io.cistem.engine.Types). Adding a type = adding an entry here (plus an icon symbol in index.html). The engine only knows behaviours; each behaviour reads the fixed field names listed under behaviours.",
  "behaviours": {
    "source": {
      "about": "Injects its peak rps into the system.",
      "reads": [
        "rps"
      ]
    },
    "balancer": {
      "about": "Capacity maxRps; splits its load evenly across what it connects to.",
      "reads": [
        "maxRps",
        "latency"
      ]
    },
    "limit": {
      "about": "Capacity maxRps; passes all of its load on to everything it connects to.",
      "reads": [
        "maxRps",
        "latency"
      ]
    },
    "scaled": {
      "about": "Capacity instances × rpsPerInstance.",
      "reads": [
        "instances",
        "rpsPerInstance",
        "latency"
      ]
    },
    "cache": {
      "about": "Capacity maxOps; only misses (1 − hitRatio) go downstream.",
      "reads": [
        "maxOps",
        "hitRatio",
        "latency"
      ]
    },
    "store": {
      "about": "Reads spread over primary + replicas, writes hit the primary; capacity from maxQps per node.",
      "reads": [
        "maxQps",
        "replicas",
        "readShare",
        "latency"
      ]
    },
    "async": {
      "about": "A queue/topic: capacity maxThroughput, or partitions × msgPerPartition for a partitioned topic (whose consumers use at most one instance per partition); consumers pull, and what they consumed is never republished into it.",
      "reads": [
        "maxThroughput",
        "msgPerPartition",
        "partitions",
        "latency"
      ]
    }
  },
